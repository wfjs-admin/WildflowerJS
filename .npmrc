# Block lifecycle scripts (preinstall / install / postinstall / etc.) from
# every package on `npm install`. Defense-in-depth against postinstall-based
# supply-chain attacks (event-stream, Shai-Hulud, etc.): even if a malicious
# devDependency gets pinned, npm refuses to execute its scripts.
#
# The framework build itself never runs `npm install` (the rollup + terser +
# acorn toolchain is fetched directly via SHA-512-pinned tarballs in
# scripts/fetch-*.cjs). This setting protects only the devDependencies path
# (vitest, playwright). See PROVENANCE.md.
#
# Side effect: playwright's postinstall (which would auto-download Chromium)
# is skipped. Run `npx playwright install chromium` once after the first
# `npm install` on a fresh machine (`npm run test:setup`).
ignore-scripts=true

# Always pull from the canonical npm registry, a defense against accidental
# mirrors or typo'd registries that could ship modified tarballs.
registry=https://registry.npmjs.org/
